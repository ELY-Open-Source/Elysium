{
  "$schema": "node_modules/wrangler/config-schema.json",
  // An assets-only Worker: no script, Cloudflare serves the built site from dist/.
  "name": "elysian-site",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "elysian.elydora.com",
      "custom_domain": true
    }
  ]
}
